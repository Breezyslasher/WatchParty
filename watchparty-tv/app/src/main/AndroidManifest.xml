<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- keeps the room connection alive while you watch in another app -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse: the service keeps this device in a watch party (the relay
         connection, following the room) while you watch in another app; it
         plays no media itself, so mediaPlayback didn't fit -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ hides other apps unless declared: these let the app see
         which installed app opens a shared link, show app names, and open an
         app's home screen for title-only shares -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- the system screens where notification access is switched on -->
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: a relay on the home network is usually plain http -->
    <application
        android:label="Watch Party"
        android:icon="@drawable/banner"
        android:banner="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps this device in a watch party the user joined: polls the party's relay once a second and keeps the streaming app the user is watching in sync with the other members (play, pause, seek). Runs only while the user is in a room; Leave room stops it." />
        </service>

        <!-- Reads no notifications: notification access is what unlocks other
             apps' media sessions (see SessionAccessService).
             The label starts with "A" on purpose: TV Settings sorts the
             notification-access list by this label and shows it under the
             app name. Google TV puts its own listener ("Google TV", disabled,
             "Required by system") first; a disabled first row can't take
             focus, so the remote couldn't reach any row (Chromecast HD,
             Android 14). Sorting first keeps Watch Party reachable. -->
        <service
            android:name=".SessionAccessService"
            android:exported="true"
            android:label="Allows syncing what's playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
